# 复制为 deploy/.env 后按需修改。compose.dev.yml 会自动读取。

# 控制台端口（宿主机 127.0.0.1）。改了要连同 web 容器一起重建：
#   docker compose -f deploy/compose.dev.yml up -d web twinfix-worker
TWINFIX_WEB_PORT=17317

# 鉴权：本地开发默认关闭。对外暴露前务必设为 false 并配置 >=32 字节的随机密钥：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 开启后先建一个管理员（compose 全栈时）：
#   docker compose -f deploy/compose.dev.yml exec twinfix-api twinfix-user create admin
# 宿主机运行时直接：cd server && uv run twinfix-user create admin
TWINFIX_AUTH_DISABLED=true
TWINFIX_JWT_SECRET=

# Agent 实现：stub（内置模拟 Agent）或 llm（真实模型）
TWINFIX_AGENT_MODE=stub
TWINFIX_STUB_DELAY_S=0.6

# LLM（llm 模式使用，OpenAI 兼容协议，需支持 tool calling）
TWINFIX_LLM_BASE_URL=https://api.openai.com/v1
TWINFIX_LLM_API_KEY=
TWINFIX_LLM_MODEL=gpt-4o-mini

# 真实闭环（基准测试）：本地裸仓库 + Docker 沙箱 + Compose 孪生环境
# 宿主机直接运行 api/worker 时写到 server/.env；沙箱依赖缓存卷需先预热（见 docs/07 §4.1）
# TWINFIX_AGENT_MODE=llm
# TWINFIX_CODEHOST=local
# TWINFIX_GIT_ROOT=.data/git
# TWINFIX_SANDBOX=docker
# TWINFIX_SANDBOX_NETWORK=          # 空 = 无网络离线构建（只用 twinfix-m2 卷里的依赖）
# TWINFIX_TWIN_PROVIDER=compose
# TWINFIX_TWIN_MAX_CONCURRENT=1         # 低配机器先设 1（默认 4）
# TWINFIX_TWIN_SERVICE_MEM_LIMIT=768m   # 每个孪生 Spring 服务容器的内存上限；紧张时降到 512m
# TWINFIX_TWIN_SERVICE_CPUS=1.0
# TWINFIX_TWIN_DB_MEM_LIMIT=256m
# Kubernetes 孪生（TWINFIX_TWIN_PROVIDER=k8s）：镜像由 CI 预构建，每个孪生独立 Namespace，
# Service 以 NodePort 暴露；twin_port_base..+max_concurrent*span 必须落在 30000-32767。
# TWINFIX_K8S_NODE_HOST=node1.example.com   # worker 可达的节点地址
# TWINFIX_K8S_TWIN_MANIFEST=../deploy/k8s/twin.example.yaml   # 空 = 仓库内示例模板
# TWINFIX_K8S_DEFAULT_IMAGE=registry.example/twin:latest
# TWINFIX_K8S_KUBECTL=kubectl
# TWINFIX_K8S_KUBECONFIG=/root/.kube/config
# TWINFIX_K8S_CONTEXT=
# TWINFIX_K8S_ROLLOUT_TIMEOUT_S=600
# TWINFIX_SANDBOX_CPUS=2.0              # 沙箱工作区（Maven / pytest）
# TWINFIX_SANDBOX_MEMORY_MB=2048
# TWINFIX_SANDBOX_IMAGE=twinfix-sandbox:java-21   # Java 项目（默认 maven:3.9.9-eclipse-temurin-21）
# TWINFIX_SANDBOX_IMAGE_PYTHON=twinfix-sandbox-python:3.12  # Python 项目（按 Project.language 自动选择）
# TWINFIX_SANDBOX_IMAGE_GO=twinfix-sandbox-go:1.25          # Go 项目（go build / go test）
# TWINFIX_SANDBOX_IMAGE_TYPESCRIPT=twinfix-sandbox-typescript:22  # TypeScript / JavaScript 项目（node --test）
# TWINFIX_SANDBOX_IMAGE_CSHARP=twinfix-sandbox-csharp:10.0        # C# / .NET 项目（dotnet run 测试工程）
# TWINFIX_EVAL_GO_IMAGE=                                    # 宿主机无 Go 时，用 docker 镜像判分 Go 用例
# TWINFIX_EVAL_NODE_IMAGE=                                  # 宿主机无 Node 22+ 时，用 docker 镜像判分 TypeScript 用例
# TWINFIX_EVAL_CSHARP_IMAGE=                                # 宿主机无 .NET SDK 时，用 docker 镜像判分 C# 用例

# GitHub Issue 入口：POST /api/webhooks/github（GitHub App 或仓库 webhook，事件选 Issues）
# 必须配置密钥，否则一律 401。Issue 打上项目的触发标签（project.config.issue_label，默认 twinfix）即上报；
# S1–S4 标签作为严重级别。项目按 repository.full_name 与 project.repo 匹配。
# TWINFIX_GITHUB_WEBHOOK_SECRET=

# GitLab 代码托管：TWINFIX_CODEHOST=gitlab 时启用。access token 需要 api + write_repository scope；
# 自建实例把 BASE_URL 指到实例根地址（如 https://gitlab.example.com），挂在子路径时再配 API_URL。
# TWINFIX_GITLAB_BASE_URL=https://gitlab.com
# TWINFIX_GITLAB_API_URL=                 # 空 = <BASE_URL>/api/v4
# TWINFIX_GITLAB_TOKEN=glpat-xxxxxxxx
# GitLab 项目 Webhook：POST /api/webhooks/gitlab，GitLab 侧 Secret token 填同一个值。
# 事件勾选 Issue events + Merge request events；Issue 打上触发标签（默认 twinfix）即上报。
# TWINFIX_GITLAB_WEBHOOK_SECRET=
# GitLab CI 孪生部署（TWINFIX_CI=gitlab）：流水线所在项目与触发令牌（留空复用 GITLAB_TOKEN）
# TWINFIX_GITLAB_CI_PROJECT=group/twinfix-infra
# TWINFIX_GITLAB_CI_REF=main
# TWINFIX_GITLAB_CI_TOKEN=

# Alertmanager / Grafana 告警入口：POST /api/webhooks/alertmanager（或 /grafana）
# 请求头 Authorization: Bearer <secret>（Alertmanager 的 http_config.authorization.credentials）。
# 只接 firing；项目取 labels.twinfix_project / project，全库只有一个项目时可省略。
# TWINFIX_ALERT_WEBHOOK_SECRET=

# Jenkins 孪生部署回调：POST /api/webhooks/jenkins（deploy/jenkins/twinfix-twin-deploy.Jenkinsfile 的 post.always）
# 载荷 {"twin": "<compose 项目名>", "status": "ready"|"failed", "sha": "...", "build": "...", "urls": {...}}，
# 请求头 Authorization: Bearer <secret>。按 compose 项目名更新 Twin 状态，重复回调幂等。
# TWINFIX_JENKINS_WEBHOOK_SECRET=

# 定时日志扫描（worker 任务，需要 TWINFIX_OBSERVABILITY=stack 且配置 TWINFIX_ELASTICSEARCH_URL）
# 每轮按窗口查 ES，把 ERROR/异常按堆栈指纹聚成 LOG 信号；窗口重叠只会归并到未关闭事故，不重复建案。
# 项目可用 project.config.logscan 覆盖：{"enabled","query","services","env","severity","lookback_s","max_signals","max_lines"}
# TWINFIX_LOGSCAN_ENABLED=false
# TWINFIX_LOGSCAN_INTERVAL_S=300
# TWINFIX_LOGSCAN_LOOKBACK_S=600
# TWINFIX_LOGSCAN_QUERY=(log.level:(ERROR OR FATAL OR SEVERE)) OR (level:(ERROR OR FATAL OR SEVERE))
# TWINFIX_LOGSCAN_LIMIT=200
# TWINFIX_LOGSCAN_MAX_SIGNALS=10

# 控制台发起评测（POST /api/eval/runs）：由 API 拉起独立子进程执行 twinfix-arena eval，
# 子进程按该地址回连本 API；报告写在 TWINFIX_EVAL_REPORTS_DIR。
# 前提：TWINFIX_AGENT_MODE=llm、TWINFIX_CODEHOST=local、arena/demo-shop 存在。
# TWINFIX_API_SELF_URL=http://127.0.0.1:8000/api

# 可观测后端（TWINFIX_OBSERVABILITY=stack 时按 URL 逐项启用，未配的项回退空实现）
# TWINFIX_OBSERVABILITY=stack
# TWINFIX_PROMETHEUS_URL=http://127.0.0.1:9090
# TWINFIX_ELASTICSEARCH_URL=http://127.0.0.1:9200
# TWINFIX_ES_LOGS_INDEX=logs-*
# TWINFIX_SKYWALKING_URL=http://127.0.0.1:12800/graphql
# 部署记录（recent_deploys 工具）：PromQL 模板，{service} 会替换；空 = 返回空列表。
# 约定：deploy_timestamp_seconds 的样本值是部署时间；deploy_info 用窗口内首个采样点近似。
# TWINFIX_DEPLOY_QUERY=deploy_timestamp_seconds{service="{service}"}

# 自身可观测性：GET /api/metrics 输出 Prometheus text format（API 与 worker 共享同一份数据库聚合）。
# 默认开启；metrics token 留空时只允许 auth_disabled 的本地实例访问，开启鉴权前务必配置随机 token：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# TWINFIX_METRICS_ENABLED=true
# TWINFIX_METRICS_TOKEN=

# 链路追踪（可选）：worker 把 worker.step / agent.run / tool.call / chat span 导出到 OTLP/HTTP
# （Jaeger、Tempo、OpenTelemetry Collector 均可）。默认关闭；只导出标识与用量，
# 不含 Prompt、源码、工具参数与结果。endpoint 可写收集器基地址或完整 /v1/traces。
# 观测栈 compose 里的 Jaeger：宿主机跑 worker 用 http://127.0.0.1:4318；
# 容器内跑 worker 用 http://host.docker.internal:4318。
# TWINFIX_OTEL_ENABLED=false
# TWINFIX_OTEL_ENDPOINT=http://127.0.0.1:4318
# TWINFIX_OTEL_SERVICE_NAME=twinfix
# TWINFIX_OTEL_SAMPLE_RATIO=1.0
# TWINFIX_ARENA_DEMO_SHOP_DIR=../arena/demo-shop   # 空 = arena/cases 的同级 demo-shop
# 容器内评测判分用（compose.dev.yml 已注入；宿主机跑 CLI 时留空即可）
# TWINFIX_EVAL_MAVEN_SETTINGS=/deploy/maven/eval-settings.xml
# TWINFIX_EVAL_MAVEN_REPO=/data/m2/repository

# Agent 预算与模型（全局默认；控制台"设置"页或 PUT /api/projects/{name}/agent-config 可按项目、按 Agent 覆盖）
# TWINFIX_BUDGET_MAX_TOKENS=2000000      # 单个 Agent 一次运行的 token 上限
# TWINFIX_BUDGET_MAX_TOOL_CALLS=120
# TWINFIX_BUDGET_MAX_SECONDS=2400
# TWINFIX_AGENT_MAX_TURNS=60
# TWINFIX_LLM_REASONING_EFFORT=low       # 推理模型思考深度：low / medium / high；空 = 模型默认

# 对照实验开关（默认全开 = 完整流水线；改完需重启 worker 生效）
# TWINFIX_REPRO_REQUIRED=false          # 去掉"先复现"约束：诊断后直接修复，没有复现用例作验收标准
# TWINFIX_REPRO_CONFIRM=false           # 采信 Agent 自报的复现次数，系统不在沙箱里独立重跑确认
# TWINFIX_INTEGRITY_CHECK=false         # 关闭测试完整性扫描（补丁删/跳过/弱化测试不再判失败）
# TWINFIX_PRECEDENTS_ENABLED=false      # 诊断时不注入同项目历史判例
# TWINFIX_LOG_CLUSTER=false             # search_logs 不再给模板摘要，直接回贴原始行
