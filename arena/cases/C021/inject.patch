+package com.acme.order.infra;
+
+import org.springframework.web.client.RestClient;
+
+public class HttpPaymentGateway implements PaymentGateway {
+
+    private final RestClient http;
+
+    public HttpPaymentGateway(RestClient http) {
+        this.http = http;
+    }
+
+    public static HttpPaymentGateway create(String baseUrl) {
+        return new HttpPaymentGateway(RestClient.builder().baseUrl(baseUrl).build());
+    }
+
+    @Override
+    public PaymentStatus query(String paymentId) {
+        return http.get()
+                .uri("/v1/payments/{id}", paymentId)
+                .retrieve()
+                .body(PaymentStatus.class);
+    }
+}
