+package com.acme.order.report;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.acme.order.domain.Order;
+import com.acme.order.domain.PriceBreakdown;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class DailySalesTest {
+
+    private final DailySales sales = new DailySales(ZoneId.of("Asia/Shanghai"));
+
+    private static Order order(String createdAt, String total) {
+        BigDecimal t = new BigDecimal(total);
+        return new Order(1L, "u", List.of(), new PriceBreakdown(t, BigDecimal.ZERO, t, null), "PAID", Instant.parse(createdAt));
+    }
+
+    @Test
+    void sumsOrdersOfTheSameDay() {
+        var totals = sales.totalsByDay(List.of(order("2026-03-10T04:00:00Z", "10.00"), order("2026-03-10T06:30:00Z", "5.50")));
+        assertThat(totals).containsEntry(LocalDate.parse("2026-03-10"), new BigDecimal("15.50"));
+    }
+}
