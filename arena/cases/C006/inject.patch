+package com.acme.order.report;
+
+import com.acme.order.domain.Order;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/** 日销售额：按门店所在时区的自然日汇总订单实付金额（对账、运营日报使用）。 */
+public class DailySales {
+
+    private final ZoneId shopZone;
+
+    public DailySales(ZoneId shopZone) {
+        this.shopZone = shopZone;
+    }
+
+    public ZoneId shopZone() {
+        return shopZone;
+    }
+
+    /** 订单所属营业日。 */
+    public LocalDate businessDay(Order order) {
+        // createdAt 存的是 UTC 时间戳，直接取日期即可
+        return LocalDate.ofInstant(order.createdAt(), ZoneOffset.UTC);
+    }
+
+    public Map<LocalDate, BigDecimal> totalsByDay(List<Order> orders) {
+        Map<LocalDate, BigDecimal> totals = new TreeMap<>();
+        for (Order o : orders) {
+            totals.merge(businessDay(o), o.price().total(), BigDecimal::add);
+        }
+        return totals;
+    }
+}
