+    @Override
+    public List<Order> findAllById(List<Long> ids) {
+        if (ids.isEmpty()) {
+            return List.of();
+        }
+        Map<Long, List<OrderLine>> lines = new HashMap<>();
+        jdbc.sql("SELECT order_id, sku, quantity, unit_price FROM order_line WHERE order_id IN (:ids) ORDER BY id")
+                .param("ids", ids)
+                .query((rs, n) -> {
+                    lines.computeIfAbsent(rs.getLong("order_id"), k -> new ArrayList<>())
+                            .add(new OrderLine(rs.getString("sku"), rs.getInt("quantity"), rs.getBigDecimal("unit_price")));
+                    return null;
+                })
+                .list();
+        Map<Long, Order> byId = new HashMap<>();
+        jdbc.sql("SELECT * FROM orders WHERE id IN (:ids)")
+                .param("ids", ids)
+                .query((rs, n) -> new Order(
+                        rs.getLong("id"),
+                        rs.getString("customer"),
+                        lines.getOrDefault(rs.getLong("id"), List.of()),
+                        new PriceBreakdown(rs.getBigDecimal("subtotal"), rs.getBigDecimal("discount"),
+                                rs.getBigDecimal("total"), rs.getString("coupon_code")),
+                        rs.getString("status"),
+                        rs.getTimestamp("created_at").toInstant()))
+                .list()
+                .forEach(o -> byId.put(o.id(), o));
+        return ids.stream().map(byId::get).filter(java.util.Objects::nonNull).toList();
+    }
