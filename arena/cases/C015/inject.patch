+package com.acme.inventory.messaging;
+
+/** 消费结果，由监听容器翻译成 broker 动作。 */
+public enum Ack {
+    /** 处理完成，确认消息。 */
+    ACK,
+    /** 放回队列稍后重投。 */
+    REQUEUE,
+    /** 拒绝且不重投，路由到死信队列等待人工处理。 */
+    DEAD_LETTER
+}
