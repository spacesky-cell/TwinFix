@@ -0,0 +1,33 @@
+package com.acme.inventory.messaging;
+
+import com.acme.inventory.domain.OutOfStockException;
+import com.acme.inventory.service.StockService;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** 消费 stock.reserve：异步为订单占用库存。 */
+public class ReserveListener {
+
+    private static final Logger log = LoggerFactory.getLogger(ReserveListener.class);
+
+    private final StockService stock;
+
+    public ReserveListener(StockService stock) {
+        this.stock = stock;
+    }
+
+    public Ack handle(ReserveMessage msg) {
+        try {
+            stock.reserve(msg.sku(), msg.quantity());
+            return Ack.ACK;
+        } catch (OutOfStockException e) {
+            // 库存不足是业务结果：确认消息，由订单侧超时关单
+            log.info("out of stock for order {}: {}", msg.orderId(), e.getMessage());
+            return Ack.ACK;
+        } catch (RuntimeException e) {
+            // 数据库抖动等临时故障：放回队列，稍后重试
+            log.error("reserve failed for message {} (delivery {}), requeue", msg.messageId(), msg.deliveryCount(), e);
+            return Ack.REQUEUE;
+        }
+    }
+}
