+package com.acme.order.refund;
+
+import com.fasterxml.jackson.annotation.JsonFormat;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/**
+ * 售后退款申请（客服工作台提交）。
+ *
+ * @param receivedOn 客户签收日期，用于判断是否在 7 天无理由退货期内
+ */
+public record RefundRequest(
+        long orderId,
+        BigDecimal amount,
+        String reason,
+        @JsonFormat(shape = JsonFormat.Shape.STRING, pattern = "yyyy/MM/dd") LocalDate receivedOn) {
+}
