+package com.acme.order.refund;
+
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/refunds")
+public class RefundController {
+
+    private final RefundPolicy policy;
+
+    public RefundController(RefundPolicy policy) {
+        this.policy = policy;
+    }
+
+    /** 退款预审：通过返回 202，由财务异步打款。 */
+    @PostMapping
+    @ResponseStatus(HttpStatus.ACCEPTED)
+    public Map<String, Object> apply(@RequestBody RefundRequest req) {
+        policy.check(req);
+        return Map.of("orderId", req.orderId(), "status", "ACCEPTED");
+    }
+}
