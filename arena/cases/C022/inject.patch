@@ -0,0 +1,30 @@
+package com.acme.order.refund;
+
+import com.acme.order.domain.BizException;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.time.ZoneId;
+
+/** 7 天无理由退货：签收次日起算 7 个自然日（营业时区）。 */
+public class RefundPolicy {
+
+    static final int RETURN_WINDOW_DAYS = 7;
+
+    private final Clock clock;
+    private final ZoneId zone;
+
+    public RefundPolicy(Clock clock, ZoneId zone) {
+        this.clock = clock;
+        this.zone = zone;
+    }
+
+    public void check(RefundRequest req) {
+        if (req.amount() == null || req.amount().signum() <= 0) {
+            throw new BizException("INVALID_REFUND", "refund amount must be positive");
+        }
+        LocalDate today = LocalDate.now(clock.withZone(zone));
+        if (req.receivedOn().plusDays(RETURN_WINDOW_DAYS).isBefore(today)) {
+            throw new BizException("RETURN_WINDOW_EXPIRED", "received on " + req.receivedOn() + ", window is " + RETURN_WINDOW_DAYS + " days");
+        }
+    }
+}
