+package com.acme.order.report;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.lang.reflect.Proxy;
+import java.math.BigDecimal;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.time.Instant;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.Test;
+
+class JdbcSalesReportTest {
+
+    @SuppressWarnings("unchecked")
+    private static <T> T proxy(Class<T> type, java.lang.reflect.InvocationHandler h) {
+        return (T) Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[] {type}, h);
+    }
+
+    private static DataSource rows(List<Map.Entry<String, BigDecimal>> data) {
+        Iterator<Map.Entry<String, BigDecimal>> it = data.iterator();
+        Map.Entry<String, BigDecimal>[] cur = new Map.Entry[1];
+        ResultSet rs = proxy(ResultSet.class, (p, m, a) -> switch (m.getName()) {
+            case "next" -> {
+                boolean has = it.hasNext();
+                cur[0] = has ? it.next() : null;
+                yield has;
+            }
+            case "getString" -> cur[0].getKey();
+            case "getBigDecimal" -> cur[0].getValue();
+            default -> null;
+        });
+        PreparedStatement ps = proxy(PreparedStatement.class, (p, m, a) -> m.getName().equals("executeQuery") ? rs : null);
+        Connection conn = proxy(Connection.class, (p, m, a) -> m.getName().equals("prepareStatement") ? ps : null);
+        return proxy(DataSource.class, (p, m, a) -> m.getName().equals("getConnection") ? conn : null);
+    }
+
+    @Test
+    void aggregatesInQueryOrder() {
+        var report = new JdbcSalesReport(rows(List.of(
+                Map.entry("SKU-1", new BigDecimal("598.00")),
+                Map.entry("SKU-2", new BigDecimal("89.90")))));
+        var result = report.salesBySku(Instant.parse("2026-10-01T00:00:00Z"), Instant.parse("2026-11-01T00:00:00Z"));
+        assertThat(result).containsExactly(
+                Map.entry("SKU-1", new BigDecimal("598.00")),
+                Map.entry("SKU-2", new BigDecimal("89.90")));
+    }
+}
