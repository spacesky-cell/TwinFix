+package com.acme.order.report;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.Map;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/reports")
+public class SalesReportController {
+
+    private final SalesReport report;
+
+    public SalesReportController(SalesReport report) {
+        this.report = report;
+    }
+
+    @GetMapping("/sales-by-sku")
+    public Map<String, BigDecimal> salesBySku(@RequestParam Instant from, @RequestParam Instant to) {
+        return report.salesBySku(from, to);
+    }
+}
