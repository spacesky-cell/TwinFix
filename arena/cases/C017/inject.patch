+package com.acme.order.domain;
+
+import java.text.ParseException;
+import java.text.SimpleDateFormat;
+import java.time.Instant;
+import java.util.Date;
+import java.util.TimeZone;
+
+/**
+ * 对外展示的订单号：{@code SO<下单日 yyyyMMdd>-<id 六位补零>}，如 SO20260101-000042。
+ * 客服按订单号查询时先解析出日期，与订单实际下单日核对，防止拿 id 乱猜。
+ */
+public final class OrderNo {
+
+    // 订单号日期统一按 UTC
+    private static final SimpleDateFormat DAY = new SimpleDateFormat("yyyyMMdd");
+
+    static {
+        DAY.setTimeZone(TimeZone.getTimeZone("UTC"));
+        DAY.setLenient(false);
+    }
+
+    private OrderNo() {
+    }
+
+    public static String of(long id, Instant createdAt) {
+        return "SO" + DAY.format(Date.from(createdAt)) + "-" + String.format("%06d", id);
+    }
+
+    /** 订单号里的下单日（当天 00:00 UTC）。 */
+    public static Instant dayOf(String orderNo) {
+        if (orderNo == null || !orderNo.matches("SO\\d{8}-\\d{6,}")) {
+            throw new BizException("INVALID_ORDER_NO", "invalid order no " + orderNo);
+        }
+        try {
+            return DAY.parse(orderNo.substring(2, 10)).toInstant();
+        } catch (ParseException e) {
+            throw new BizException("INVALID_ORDER_NO", "invalid order no " + orderNo);
+        }
+    }
+
+    public static long idOf(String orderNo) {
+        dayOf(orderNo);
+        return Long.parseLong(orderNo.substring(11));
+    }
+}
