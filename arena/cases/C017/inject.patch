+    public Order getByNo(String orderNo) {
+        long id = OrderNo.idOf(orderNo);
+        Order order = orders.findById(id).orElse(null);
+        if (order == null || !OrderNo.of(order.id(), order.createdAt()).equals(orderNo)) {
+            throw new BizException("ORDER_NOT_FOUND", "order " + orderNo + " not found");
+        }
+        return order;
+    }
