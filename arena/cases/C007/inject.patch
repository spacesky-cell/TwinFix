@@ -76,8 +76,14 @@ public class OrderService {
 
     @Transactional
     public Order markPaid(long id) {
-        get(id); // 存在性校验，缺失抛 ORDER_NOT_FOUND 并回滚
+        Order order = get(id); // 存在性校验，缺失抛 ORDER_NOT_FOUND 并回滚
         orders.saveStatus(id, "PAID");
+        try {
+            orders.recordPayment(id, order.price().total());
+        } catch (RuntimeException e) {
+            // 流水写失败不影响支付结果，夜间对账任务会补齐
+            log.warn("payment ledger write failed for order {}: {}", id, e.getMessage());
+        }
         return get(id);
     }
 
