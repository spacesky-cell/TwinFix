+    @Override
+    public List<Order> findPage(int offset, int size) {
+        return jdbc.sql("SELECT id FROM orders ORDER BY id LIMIT :size OFFSET :offset")
+                .param("size", size)
+                .param("offset", offset)
+                .query(Long.class)
+                .list()
+                .stream()
+                .map(id -> findById(id).orElseThrow())
+                .toList();
+    }
