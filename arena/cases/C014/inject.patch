+package com.acme.inventory.messaging;
+
+/** 已处理事件的记录（审计与排查用）。 */
+public interface ProcessedEvents {
+
+    /**
+     * 记下事件已处理。
+     *
+     * @return true 表示首次记录；false 表示该 eventId 之前已经记录过
+     */
+    boolean record(String eventId);
+}
