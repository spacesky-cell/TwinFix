@@ -0,0 +1,20 @@
+package com.acme.inventory.messaging;
+
+import org.springframework.jdbc.core.simple.JdbcClient;
+
+public class JdbcProcessedEvents implements ProcessedEvents {
+
+    private final JdbcClient jdbc;
+
+    public JdbcProcessedEvents(JdbcClient jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    @Override
+    public boolean record(String eventId) {
+        int inserted = jdbc.sql("INSERT INTO processed_event (event_id, processed_at) VALUES (:id, now()) ON CONFLICT DO NOTHING")
+                .param("id", eventId)
+                .update();
+        return inserted == 1;
+    }
+}
