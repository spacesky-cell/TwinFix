+package com.acme.inventory.messaging;
+
+import com.acme.inventory.service.StockService;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * 订阅 order.created：下单后异步扣减库存。
+ * MQ 是至少一次投递：消费者超时、连接断开、未 ack 时 broker 会重投同一条消息。
+ */
+public class OrderEventConsumer {
+
+    private static final Logger log = LoggerFactory.getLogger(OrderEventConsumer.class);
+
+    private final StockService stock;
+    private final ProcessedEvents processed;
+
+    public OrderEventConsumer(StockService stock, ProcessedEvents processed) {
+        this.stock = stock;
+        this.processed = processed;
+    }
+
+    public void onOrderCreated(OrderCreatedEvent event) {
+        stock.reserve(event.sku(), event.quantity());
+        processed.record(event.eventId());
+        log.info("reserved {} x{} for order {} (event {})", event.sku(), event.quantity(), event.orderId(), event.eventId());
+    }
+}
