+package com.acme.order.notify;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.acme.order.domain.Order;
+import com.acme.order.domain.PriceBreakdown;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+
+class OrderNotifierTest {
+
+    private static Order order(long id) {
+        BigDecimal t = new BigDecimal("10.00");
+        return new Order(id, "u-" + id, List.of(), new PriceBreakdown(t, BigDecimal.ZERO, t, null), "CREATED", Instant.EPOCH);
+    }
+
+    @Test
+    void sendsAsynchronously() throws Exception {
+        List<String> sent = new CopyOnWriteArrayList<>();
+        try (var notifier = new OrderNotifier((c, m) -> sent.add(c), 2)) {
+            for (long i = 1; i <= 20; i++) {
+                notifier.orderCreated(order(i));
+            }
+            notifier.executor().shutdown();
+            assertThat(notifier.executor().awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+        }
+        assertThat(sent).hasSize(20);
+    }
+
+    @Test
+    void senderFailureDoesNotKillPool() throws Exception {
+        try (var notifier = new OrderNotifier((c, m) -> { throw new IllegalStateException("sms gateway 503"); }, 1)) {
+            notifier.orderCreated(order(1));
+            notifier.orderCreated(order(2));
+            notifier.executor().shutdown();
+            assertThat(notifier.executor().awaitTermination(5, TimeUnit.SECONDS)).isTrue();
+            assertThat(notifier.executor().getCompletedTaskCount()).isEqualTo(2);
+        }
+    }
+}
