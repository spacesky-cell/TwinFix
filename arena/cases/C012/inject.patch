+package com.acme.order.infra;
+
+import java.math.BigDecimal;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** 进程内商品价格缓存：下单热路径每行都要查价，商品表变化很少。 */
+public class CachingProductRepository implements ProductRepository {
+
+    private final ProductRepository delegate;
+    private final Map<String, BigDecimal> cache = new ConcurrentHashMap<>();
+
+    public CachingProductRepository(ProductRepository delegate) {
+        this.delegate = delegate;
+    }
+
+    @Override
+    public Optional<BigDecimal> findPrice(String sku) {
+        BigDecimal cached = cache.get(sku);
+        if (cached != null) {
+            return Optional.of(cached);
+        }
+        Optional<BigDecimal> loaded = delegate.findPrice(sku);
+        loaded.ifPresent(p -> cache.put(sku, p));
+        return loaded;
+    }
+
+    @Override
+    public void updatePrice(String sku, BigDecimal price) {
+        delegate.updatePrice(sku, price);
+    }
+}
