+package com.acme.order.infra;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+class CachingProductRepositoryTest {
+
+    @Test
+    void secondLookupIsServedFromCache() {
+        AtomicInteger calls = new AtomicInteger();
+        Map<String, BigDecimal> prices = Map.of("SKU-1", new BigDecimal("299.00"));
+        var repo = new CachingProductRepository(sku -> {
+            calls.incrementAndGet();
+            return Optional.ofNullable(prices.get(sku));
+        });
+
+        assertThat(repo.findPrice("SKU-1")).contains(new BigDecimal("299.00"));
+        assertThat(repo.findPrice("SKU-1")).contains(new BigDecimal("299.00"));
+        assertThat(calls).hasValue(1);
+    }
+}
