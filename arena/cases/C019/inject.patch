+    /** 带幂等键下单：网络超时后客户端重试不会产生重复订单。 */
+    public Order create(CreateOrder req, String idempotencyKey) {
+        if (idempotencyKey == null || idempotencyKey.isBlank()) {
+            return create(req);
+        }
+        Long existing = idempotentOrders.get(idempotencyKey);
+        if (existing != null) {
+            log.info("idempotent replay {} -> order {}", idempotencyKey, existing);
+            return get(existing);
+        }
+        Order created = create(req);
+        idempotentOrders.put(idempotencyKey, created.id());
+        return created;
+    }
+
+    /** 幂等表当前条目数（暴露给监控）。 */
+    public int idempotencyEntries() {
+        return idempotentOrders.size();
+    }
+
     public Order get(long id) {
         return orders.findById(id).orElseThrow(() -> new BizException("ORDER_NOT_FOUND", "order " + id + " not found"));
     }
