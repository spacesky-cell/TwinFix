+    /** 盘点对账：body 为 {sku: 实盘数量}，返回不一致的 SKU 及系统库存。 */
+    @PostMapping("/reconcile")
+    public Map<String, Object> reconcile(@RequestBody Map<String, Integer> counted) {
+        Map<String, Integer> mismatched = service.reconcile(counted);
+        if (!mismatched.isEmpty()) {
+            log.warn("stock reconcile mismatched {} of {} skus: {}", mismatched.size(), counted.size(), mismatched.keySet());
+        }
+        return Map.of("checked", counted.size(), "mismatched", mismatched);
+    }
