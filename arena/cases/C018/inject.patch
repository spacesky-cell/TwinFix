+
+    /**
+     * 盘点对账：把仓库实盘数量与系统库存比对，返回不一致的 SKU → 系统库存（系统里没有的 SKU 记为 null）。
+     */
+    public Map<String, Integer> reconcile(Map<String, Integer> counted) {
+        Map<String, Integer> system = repo.snapshot(counted.keySet());
+        Map<String, Integer> mismatched = new TreeMap<>();
+        for (Map.Entry<String, Integer> e : counted.entrySet()) {
+            Integer actual = system.get(e.getKey());
+            if (actual != e.getValue()) {
+                mismatched.put(e.getKey(), actual);
+            }
+        }
+        return mismatched;
+    }
 }
