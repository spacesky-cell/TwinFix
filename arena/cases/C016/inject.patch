 import com.acme.inventory.domain.OutOfStockException;
 import com.acme.inventory.infra.StockRepository;
+import java.util.Map;
 import java.util.NoSuchElementException;
+import java.util.concurrent.ConcurrentHashMap;
 
 public class StockService {
 
     private final StockRepository repo;
+    // 每个 SKU 一把进程内锁：调拨的"扣减 + 入库"两步之间不允许其他调拨插进来
+    private final Map<String, Object> locks = new ConcurrentHashMap<>();
 
     public StockService(StockRepository repo) {
         this.repo = repo;
@@ -33,4 +37,26 @@ public class StockService {
         }
         repo.release(sku, quantity);
     }
+
+    /** 仓间调拨：把 {@code quantity} 件库存从 fromSku 挪到 toSku（如换包装、拆套装）。 */
+    public void transfer(String fromSku, String toSku, int quantity) {
+        if (quantity <= 0) {
+            throw new IllegalArgumentException("quantity must be positive");
+        }
+        if (fromSku.equals(toSku)) {
+            throw new IllegalArgumentException("cannot transfer to the same sku");
+        }
+        synchronized (lockFor(fromSku)) {
+            synchronized (lockFor(toSku)) {
+                if (!repo.tryReserve(fromSku, quantity)) {
+                    throw new OutOfStockException(fromSku, quantity, available(fromSku));
+                }
+                repo.restock(toSku, quantity);
+            }
+        }
+    }
+
+    private Object lockFor(String sku) {
+        return locks.computeIfAbsent(sku, k -> new Object());
+    }
 }
